# Copy this file to `.env` and fill in real values. NEVER commit real secrets.

# ── Database (Supabase Postgres) ──────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# ── Clerk auth ────────────────────────────────────────────────
CLERK_SECRET_KEY=<your-clerk-secret-key>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk user id of the store administrator
ADMIN_USER_ID=user_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase storage (server-only; use the service-role key, never expose it) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>

# Public, canonical URL of this app. QiCard callbacks must reach it over HTTPS.
WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# ── QiCard payment gateway ────────────────────────────────────
QICARD_BASE_URL=https://uat-sandbox-3ds-api.qi.iq/api/v1
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
# PEM public key used to verify webhook signatures (required in production)
QICARD_PUBLIC_KEY=
