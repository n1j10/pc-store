# Copy to .env.local and fill in real values. Never commit real secrets.

# PostgreSQL (Supabase pooler for runtime, direct for migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk user id that is allowed into /admin
ADMIN_USER_ID=user_xxx

# Supabase Storage (product & category images)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-anon-key

# Public canonical URL (QiCard callbacks must reach it over HTTPS)
WEBSITE_URL=http://localhost:3000

# QiCard payment gateway (falls back to the public UAT sandbox when empty)
QICARD_BASE_URL=
QICARD_USERNAME=
QICARD_PASSWORD=
QICARD_TERMINAL_ID=
QICARD_PUBLIC_KEY=
